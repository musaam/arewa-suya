rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The single shared staff/admin account. Update this to match the email
    // of the Firebase Auth user you create for the shop.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'server@arewasuyaspot.ca';
    }

    // Orders: customers create them (unauthenticated checkout); only the admin
    // can read them (they contain customer PII) and update their status.
    match /orders/{orderId} {
      // Public checkout writes new orders. Require the shape we expect and that
      // a new order always starts as 'active'. Orders can never be deleted.
      allow create: if request.resource.data.status == 'active'
        && request.resource.data.keys().hasAll(['customer', 'items', 'grandTotal']);

      allow read: if isAdmin();

      // Admin may only flip an active order to completed (or back), not rewrite
      // the order contents.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'completedAt']);

      allow delete: if false;
    }

    // Order-number counter used by the checkout transaction. Needs to be
    // readable/writable by the unauthenticated checkout flow.
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
